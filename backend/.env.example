# ===== Backend environment =====
# Copy to backend/.env  (cp .env.example .env)

# local | staging | prod   (prod enforces strict checks at startup)
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Postgres — swap credentials for your local install (or docker compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
DB_ECHO=false

# Redis (optional in local phase 1; jobs/rate limiter use it)
REDIS_URL=redis://localhost:6379/0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRES_MIN=15
REFRESH_EXPIRES_DAYS=7

# Frontend origin(s), comma-separated
FRONTEND_ORIGIN=http://localhost:3000

# Razorpay (test keys first: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email (Resend) — unset = mock mode (emails logged to console)
RESEND_API_KEY=
EMAIL_FROM=E-Commerce <orders@example.com>

# Media uploads (docs/04 §8) — local mock dir until R2/S3 keys are configured
MEDIA_DIR=uploads
MAX_UPLOAD_MB=5

# Expired-stock-reservation sweep loop (ARQ replacement; cron-style when on Redis)
RESERVATION_SWEEP_SECONDS=60

# Store defaults
CURRENCY=INR
FLAT_SHIPPING_FEE=9900        # paise
FREE_SHIPPING_THRESHOLD=99900 # paise
TAX_PERCENT=0

# Seed admin (created by scripts/seed.py)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
